app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# Documentación: solo se versionan los documentos finales y las imágenes.
# Fuentes (Markdown, Mermaid, HTML), herramientas y documentación interna
# (división de tareas, tickets, scripts) quedan fuera del repositorio.
/docs/**
!/docs/**/
!/docs/**/*.pdf
!/docs/**/*.png
!/docs/**/*.svg
!/docs/**/*.jpg
/docs/src/
/docs/internal/
/docs/tools/
/docs/diagrams/src/
